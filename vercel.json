{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/projects/magic-stamp", "destination": "/index.html" },
    { "source": "/projects/rahmet-ihsan", "destination": "/index.html" },
    { "source": "/projects/envaglo", "destination": "/index.html" },
    { "source": "/projects/mawared", "destination": "/index.html" },
    { "source": "/projects/mywill", "destination": "/index.html" },
    { "source": "/projects/paligram", "destination": "/index.html" },
    { "source": "/projects/reevez", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Origin-Agent-Cluster", "value": "?1" }
      ]
    }
  ]
}
