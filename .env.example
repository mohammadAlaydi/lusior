# Example environment for the API server. Copy to `.env` and adjust as needed.
# Loaded by server/src/env.ts (Node's built-in process.loadEnvFile) — the file
# must sit in the directory the server is started FROM (the repo root when
# using the root package.json scripts).

# Port the API server listens on. Falls back to 3001 when unset or invalid.
PORT=3001

# Single browser origin allowed to call the API (CORS).
# Never use '*' — keep this locked to the exact frontend origin.
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
CORS_ORIGIN=http://localhost:5173

# How many reverse-proxy hops to trust for the client IP (rate limiting).
# LEAVE UNSET when the server is reached directly — trusting X-Forwarded-For
# from arbitrary clients lets them spoof the rate limiter. Behind one nginx /
# load balancer set TRUST_PROXY=1; keywords ('loopback') and CIDRs also work.
#TRUST_PROXY=1

# Serve a built frontend from this directory (with SPA fallback for
# /projects/<slug> deep links). Unset in dev (Vite serves the frontend).
# NODE_ENV=production defaults this to ./dist.
#STATIC_DIR=dist

# Canonical persistent directory for validated newsletter/contact JSONL.
# Relative values resolve from the process working directory (default:
# ./server/data). In production, point this at one mounted, backed-up writable
# volume outside the immutable application build.
#DATA_DIR=/var/lib/reevez/submissions

# Legacy alias used only when DATA_DIR is unset.
#SUBMISSIONS_DIR=/var/lib/reevez/submissions
