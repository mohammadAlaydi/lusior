# Example environment for the API server. Copy to `.env` and adjust as needed.
# These are read by server/src/index.ts (PORT) and server/src/security.ts (CORS_ORIGIN).

# Port the API server listens on. Falls back to 3001 when unset or invalid.
PORT=3001

# Single browser origin allowed to call the API (CORS).
# Never use '*' — keep this locked to the exact frontend origin.
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
CORS_ORIGIN=http://localhost:5173
